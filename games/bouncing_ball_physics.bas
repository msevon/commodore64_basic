10 PRINT CHR$(147)
20 SR=1024:CR=55296:N=5
30 DIM X(5),Y(5),VX(5),VY(5),OX(5),OY(5)
40 R=RND(-TI)
50 FOR I=1 TO N
60 X(I)=2+RND(1)*35:Y(I)=2+RND(1)*12
70 VX(I)=(RND(1)*2-1)*.7
80 VY(I)=(RND(1)*2-1)*.5
90 OX(I)=INT(X(I)):OY(I)=INT(Y(I))
100 NEXT I
110 PRINT CHR$(147)
120 GET A$:IF A$="Q" THEN 400
130 FOR I=1 TO N
140 POKE SR+OX(I)+40*OY(I),32
150 VY(I)=VY(I)+.08
160 X(I)=X(I)+VX(I):Y(I)=Y(I)+VY(I)
170 IF X(I)<0 THEN X(I)=0:VX(I)=-VX(I)*.9
180 IF X(I)>39 THEN X(I)=39:VX(I)=-VX(I)*.9
190 IF Y(I)<1 THEN Y(I)=1:VY(I)=-VY(I)*.9
200 IF Y(I)>23 THEN Y(I)=23:VY(I)=-ABS(VY(I))*.78
210 IF Y(I)=23 AND ABS(VY(I))<.12 THEN VY(I)=0
220 OX(I)=INT(X(I)):OY(I)=INT(Y(I))
230 NEXT I
240 FOR I=1 TO N
250 POKE SR+OX(I)+40*OY(I),81
260 POKE CR+OX(I)+40*OY(I),I+1
270 NEXT I
280 FOR T=1 TO 18:NEXT T
290 GOTO 120
400 PRINT CHR$(147)
410 PRINT "BOUNCING BALLS ENDED"
420 END

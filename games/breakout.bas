10 PRINT CHR$(147)
20 SR=1024:CR=55296
30 PX=17:PY=23:BX=20:BY=20:DX=1:DY=-1:SC=0
40 FOR Y=2 TO 6
50 FOR X=1 TO 37 STEP 2
60 POKE SR+X+40*Y,160:POKE CR+X+40*Y,2+Y
70 NEXT X:NEXT Y
80 GOSUB 500
90 POKE SR+BX+40*BY,81:POKE CR+BX+40*BY,1
100 GET A$
110 IF A$="Z" AND PX>0 THEN NP=PX-1:GOSUB 600
120 IF A$="M" AND PX<34 THEN NP=PX+1:GOSUB 600
130 IF A$="Q" THEN 400
140 FOR T=1 TO 35:NEXT T
150 POKE SR+BX+40*BY,32
160 NX=BX+DX:NY=BY+DY
170 IF NX<0 OR NX>39 THEN DX=-DX:NX=BX+DX
180 IF NY<1 THEN DY=-DY:NY=BY+DY
190 IF NY=23 AND DY>0 THEN 250
200 AD=SR+NX+40*NY
210 IF NY<=6 AND PEEK(AD)=160 THEN POKE AD,32:SC=SC+1:DY=-DY:NY=BY+DY
220 BX=NX:BY=NY
230 IF BY>23 THEN 350
240 POKE SR+BX+40*BY,81:POKE CR+BX+40*BY,1:GOTO 100
250 IF NX<PX OR NX>PX+5 THEN 220
260 DY=-DY:NY=BY+DY
270 GOTO 220
350 PRINT CHR$(147)
360 PRINT "GAME OVER"
370 PRINT "SCORE:";SC
380 PRINT "PRESS R TO RESTART OR Q TO QUIT"
390 GET A$:IF A$="" THEN 390
395 IF A$="R" THEN RUN
400 PRINT CHR$(147):END
500 FOR I=0 TO 5
510 POKE SR+PX+I+40*PY,160:POKE CR+PX+I+40*PY,7
520 NEXT I
530 RETURN
600 FOR I=0 TO 5:POKE SR+PX+I+40*PY,32:NEXT I
610 PX=NP:GOSUB 500
620 RETURN

10 PRINT CHR$(147)
20 PRINT "RANDOM MAZE GENERATOR"
30 PRINT "PRESS ANY KEY TO BUILD A MAZE"
40 GET A$:IF A$="" THEN 40
50 R=RND(-TI)
60 DIM M(38,22),SX(210),SY(210),AX(4),AY(4)
70 FOR Y=0 TO 22:FOR X=0 TO 38:M(X,Y)=1:NEXT X:NEXT Y
80 X=1:Y=1:M(X,Y)=0:SP=1:SX(SP)=X:SY(SP)=Y
90 N=0
100 IF X>2 THEN IF M(X-2,Y)=1 THEN N=N+1:AX(N)=X-2:AY(N)=Y
110 IF X<36 THEN IF M(X+2,Y)=1 THEN N=N+1:AX(N)=X+2:AY(N)=Y
120 IF Y>2 THEN IF M(X,Y-2)=1 THEN N=N+1:AX(N)=X:AY(N)=Y-2
130 IF Y<20 THEN IF M(X,Y+2)=1 THEN N=N+1:AX(N)=X:AY(N)=Y+2
140 IF N>0 THEN 190
150 IF SP=1 THEN 260
160 SP=SP-1:X=SX(SP):Y=SY(SP)
170 GOTO 90
190 Q=INT(RND(1)*N)+1:NX=AX(Q):NY=AY(Q)
200 MX=(X+NX)/2:MY=(Y+NY)/2
210 M(MX,MY)=0:M(NX,NY)=0
220 X=NX:Y=NY:SP=SP+1:SX(SP)=X:SY(SP)=Y
230 GOTO 90
260 PRINT CHR$(147)
270 FOR Y=0 TO 22
280 FOR X=0 TO 38
290 IF M(X,Y)=1 THEN PRINT CHR$(160);:GOTO 310
300 PRINT " ";
310 NEXT X:PRINT
320 NEXT Y
330 PRINT "PRESS R FOR ANOTHER, Q TO QUIT"
340 GET A$:IF A$="" THEN 340
350 IF A$="R" THEN RUN
360 IF A$<>"Q" THEN 340
370 END
